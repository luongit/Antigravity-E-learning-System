# ==============================================================================
# .antigravityignore - Tối Ưu Hóa Context Window & Tiết Kiệm Token Cho Antigravity Agent
# Hệ Thống Sản Xuất Học Liệu E-Learning & Whiteboard Animation
# ==============================================================================
# LƯU Ý KỸ THUẬT: Cấu hình này chỉ nhằm BỎ QUA bước quét/đọc file vào Context Window,
# KHÔNG CẤM các script Python / Core Engine đọc/ghi file khi thực thi Task trên đĩa.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Thư mục tạm, cache, logs & archive của Agent / Runtime
# ------------------------------------------------------------------------------
runtime/cache/
runtime/logs/
runtime/archive/
runtime/temp_*/
runtime/temp_test_tts/
runtime/tasks/__pycache__/
*.log
*.tmp
*.bak

# ------------------------------------------------------------------------------
# 2. Môi trường Node.js / Python / Build dependencies (Tránh nạp hàng vạn file)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
__pycache__/
**/__pycache__/
.venv/
**/.venv/
venv/
**/venv/
*.pyc
*.pyo
*.pyd
*.lock
package-lock.json

# ------------------------------------------------------------------------------
# 3. Video thô & Tài nguyên B-Roll dung lượng lớn (Tránh quét 7.8 GB binary)
# ------------------------------------------------------------------------------
inputs/video-libraries/**
!inputs/video-libraries/.gitkeep
!inputs/video-libraries/README.md

# ------------------------------------------------------------------------------
# 4. Tài sản render tạm thời & sản phẩm xuất trong output
# ------------------------------------------------------------------------------
output/**/mp3/
output/**/images/
output/**/hyperframes/
output/**/temp_*/
output/**/frames/

# Định dạng tệp đa phương tiện & binary nặng (không nạp vào context LLM)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.mp3
*.wav
*.aac
*.flac
*.ogg
*.png
*.jpeg
*.jpg
*.webp
*.gif
*.bmp
*.ico
*.ttf
*.otf
*.woff
*.woff2
*.pptx
*.ppt
*.pdf
*.zip
*.tar.gz
*.7z

# ------------------------------------------------------------------------------
# 5. NGOẠI LỆ ĐƯỢC GIỮ LẠI ĐỂ AGENT NẠP CONTEXT (WHITELIST)
# ------------------------------------------------------------------------------
!core/**
!.agents/skills/**
!**/script.md
!**/voice-script.md
!*.md
!*.json
!*.yaml
!*.yml
